static func profession_name(p: StringName) -> String:
	return PROFESSION_NAMES.get(p, String(p))


static func sex_label(sex: StringName) -> String:
	return "М" if sex == &"m" else "Ж"


## Подставляет {м|ж} и {а} по полу.
static func gendered(text: String, sex: StringName) -> String:
	var out := ""
	var i := 0
	while i < text.length():
		var c := text[i]
		if c == "{":
			var j := text.find("}", i)
			if j > 0:
				var body := text.substr(i + 1, j - i - 1)
				var parts := body.split("|")
				if parts.size() == 1:
					parts = PackedStringArray(["", parts[0]])
				out += parts[0] if sex == &"m" else parts[1]
				i = j + 1
				continue
		out += c
		i += 1
	return out


## «34 года», «21 год», «45 лет».
static func age_text(age: int) -> String:
	var m10 := age % 10
	var m100 := age % 100
	if m10 == 1 and m100 != 11:
		return "%d год" % age
	if m10 >= 2 and m10 <= 4 and (m100 < 12 or m100 > 14):
		return "%d года" % age
	return "%d лет" % age
